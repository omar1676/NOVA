# Copia este archivo como .env y escribe la contrasena de web_nova
# (la que se tecleo al ejecutar acceso-datos/sql/19_usuario_web.sql).
# El archivo .env no se sube a Git: lo excluye el .gitignore.
PGHOST=localhost
PGPORT=5432
PGDATABASE=nova_sneakers
PGUSER=web_nova
PGPASSWORD=
PUERTO=3000

# Tienda web: el usuario tienda_nova y la contrasena que se tecleo al
# ejecutar acceso-datos/sql/20_tienda_web.sql. Si se dejan vacios, el panel
# funciona igual y la tienda responde "no disponible".
TIENDA_PGUSER=tienda_nova
TIENDA_PGPASSWORD=

# Recibo por correo al aceptarse el pago simulado (Resend, https://resend.com).
# RESEND_API_KEY es la clave de la cuenta de Resend y RESEND_FROM el remitente,
# por ejemplo: NOVA Sneakers <onboarding@resend.dev>
# Sin dominio verificado en Resend, solo llegan los correos dirigidos al correo
# de la propia cuenta de Resend. Si se dejan vacios, no se envia ningun correo y
# la compra funciona igual.
RESEND_API_KEY=
RESEND_FROM=

# Proveedor del recibo: resend (si se deja vacio) o ethereal.
# ethereal es SOLO PARA DESARROLLO: Nodemailer crea una cuenta temporal de
# Ethereal (https://ethereal.email), el correo no llega a nadie y la consola
# escribe la URL de la vista previa del recibo. No necesita claves.
# Con NODE_ENV=production se niega y no se envia ningun recibo.
CORREO_PROVEEDOR=

# Conector de Odoo de Berme (odoo.js). DESACTIVADO si falta alguna: no se
# llama a ningun servidor y la consola lo dice al arrancar. Las rutas de
# pedidos.js (crear pedidos y enviarlos a Odoo) no se montan.
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
