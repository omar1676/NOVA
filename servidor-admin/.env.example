# Copia este archivo como .env y escribe la contrasena de web_nova
# (la que se tecleo al ejecutar acceso-datos/sql/19_usuario_web.sql).
# El archivo .env no se sube a Git: lo excluye el .gitignore.
PGHOST=localhost
PGPORT=5432
PGDATABASE=nova_sneakers
PGUSER=web_nova
PGPASSWORD=
PUERTO=3000

# Tienda web: el usuario tienda_nova y la contrasena que se tecleo al
# ejecutar acceso-datos/sql/20_tienda_web.sql. Si se dejan vacios, el panel
# funciona igual y la tienda responde "no disponible".
TIENDA_PGUSER=tienda_nova
TIENDA_PGPASSWORD=
