# Copia este archivo como .env (en la misma carpeta que compose.yaml) y escribe
# las contrasenas que quieras. .env no se sube a Git: lo excluye el .gitignore.
# La base solo las usa la primera vez que se monta. Para cambiarlas despues:
#   docker compose down -v   (borra la base) y otra vez docker compose up -d

# Usuario postgres del contenedor
CLAVE_POSTGRES=
# java_nova (script 17): la que va en 02_Acceso_Datos/java/conexion.properties
CLAVE_JAVA=
# web_nova (script 19) y tienda_nova (script 20): las usa el servidor
CLAVE_WEB=
CLAVE_TIENDA=
# admin.demo, taller.demo y tienda.demo (scripts 13 y 14): para entrar al panel
CLAVE_DEMO=

# Puerto de la base en este ordenador (5433 para no chocar con un PostgreSQL local)
PUERTO_BD=5433

# Opcional, igual que en servidor-admin/.env.example: recibo por correo y Odoo
CORREO_PROVEEDOR=
RESEND_API_KEY=
RESEND_FROM=
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
